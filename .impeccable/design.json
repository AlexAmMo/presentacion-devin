  "components": [
    {
      "name": "Ficha de token · entrada",
      "kind": "chip",
      "refersTo": "ficha-entrada",
      "description": "Token de entrada: píldora sólida navy en DM Mono. Un espacio inicial se dibuja como «·».",
      "html": "<span class=\"ds-ficha ds-entrada\">Arre</span> <span class=\"ds-ficha ds-entrada\">gla</span> <span class=\"ds-ficha ds-entrada\"><span class=\"ds-sp\">·</span>la</span>",
      "css": ".ds-ficha{display:inline-flex;align-items:center;height:60px;padding:0 22px;border-radius:var(--radio-pildora);font:400 var(--tipo-mono)/1 var(--fuente-mono);white-space:pre}.ds-ficha .ds-sp{opacity:.45}.ds-entrada{background:var(--color-entrada);color:var(--color-sobre-entrada)}"
    },
    {
      "name": "Ficha de token · salida",
      "kind": "chip",
      "refersTo": "ficha-salida",
