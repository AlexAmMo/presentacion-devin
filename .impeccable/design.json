      "css": ".ds-ficha{display:inline-flex;align-items:center;height:60px;padding:0 22px;border-radius:var(--radio-pildora);font:400 var(--tipo-mono)/1 var(--fuente-mono);white-space:pre}.ds-ficha .ds-sp{opacity:.45}.ds-razonamiento{background:var(--patron-razonamiento);color:var(--color-sobre-razonamiento)}"
    },
    {
      "name": "Recipiente con capas",
      "kind": "custom",
      "refersTo": "recipiente",
      "description": "Ventana de contexto: se llena de abajo arriba; la línea de acento marca el nivel.",
      "html": "<div class=\"ds-vaso\"><div class=\"ds-recipiente\"><div class=\"ds-capa ds-c-entrada\" style=\"bottom:10px;height:96px\">Entrada</div><div class=\"ds-capa ds-c-razonamiento\" style=\"bottom:109px;height:40px\"></div><div class=\"ds-capa ds-c-salida\" style=\"bottom:152px;height:24px\"></div></div><div class=\"ds-nivel\" style=\"bottom:182px\"></div></div>",
      "css": ".ds-vaso{position:relative;width:224px;height:320px}.ds-recipiente{position:absolute;inset:0 12px;border:var(--trazo-contorno) solid var(--color-contorno);border-radius:var(--radio-l);background:var(--color-superficie);overflow:hidden}.ds-capa{position:absolute;left:10px;right:10px;border-radius:var(--radio-s);display:flex;align-items:center;padding:0 22px;font:var(--peso-enfasis) var(--tipo-etiqueta)/1 var(--fuente-texto);white-space:nowrap;overflow:hidden}.ds-c-entrada{background:var(--color-entrada);color:var(--color-sobre-entrada)}.ds-c-salida{background:var(--color-salida);box-shadow:inset 0 0 0 var(--trazo-contorno) var(--color-salida-borde)}.ds-c-razonamiento{background:var(--patron-razonamiento)}.ds-nivel{position:absolute;left:0;right:0;height:var(--trazo-fuerte);background:var(--color-acento);border-radius:3px}"
    },
    {
      "name": "Corchete de caché",
      "kind": "custom",
      "description": "Corchete a la derecha de lo que cubre: continuo con ✓ si acierta, discontinuo con ✕ si falla.",
      "html": "<div class=\"ds-cache\"><div class=\"ds-corchete\"></div><div class=\"ds-cache-lbl\"><svg class=\"ds-ic\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg>Acierto</div></div><div class=\"ds-cache\"><div class=\"ds-corchete ds-fallo\"></div><div class=\"ds-cache-lbl\">Fallo</div></div>",
      "css": ".ds-cache{display:flex;align-items:center;gap:18px;height:176px}.ds-corchete{width:20px;height:100%;border:var(--trazo-fuerte) solid var(--color-cache-acierto);border-left:0;border-radius:0 8px 8px 0}.ds-corchete.ds-fallo{border-style:dashed;border-color:var(--color-cache-fallo)}.ds-cache-lbl{display:flex;align-items:center;gap:8px;font:var(--peso-enfasis) var(--tipo-etiqueta)/1.3 var(--fuente-texto);color:var(--color-texto-1)}.ds-cache-lbl .ds-ic{color:var(--color-cache-acierto)}.ds-ic{fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex:none}"
    },
    {
      "name": "Agente",
      "kind": "card",
      "refersTo": "agente",
      "description": "Tarjeta navy sólida con el icono bot; el subagente es la misma tarjeta, más pequeña y hueca.",
      "html": "<div class=\"ds-agente\"><svg class=\"ds-ic\" width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 8V4H8\"/><rect width=\"16\" height=\"12\" x=\"4\" y=\"8\" rx=\"2\"/><path d=\"M2 14h2\"/><path d=\"M20 14h2\"/><path d=\"M15 13v2\"/><path d=\"M9 13v2\"/></svg><div><div class=\"ds-agente-nm\">Agente</div><div class=\"ds-agente-sub\">modelo · effort</div></div></div>",
      "css": ".ds-agente{box-sizing:border-box;width:390px;height:150px;display:flex;align-items:center;gap:18px;padding:0 26px;border-radius:var(--radio-m);background:var(--color-superficie-inversa);color:var(--color-texto-inverso)}.ds-agente-nm{font:var(--peso-enfasis) var(--tipo-texto)/1.1 var(--fuente-texto)}.ds-agente-sub{font:400 var(--tipo-mono-s)/1.3 var(--fuente-mono);color:var(--color-texto-inverso-2);margin-top:6px}.ds-ic{fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex:none}"
    },
    {
