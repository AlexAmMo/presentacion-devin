      "css": ".ds-ficha{display:inline-flex;align-items:center;height:60px;padding:0 22px;border-radius:var(--radio-pildora);font:400 var(--tipo-mono)/1 var(--fuente-mono);white-space:pre}.ds-ficha .ds-sp{opacity:.45}.ds-salida{background:var(--color-salida);color:var(--color-sobre-salida);box-shadow:inset 0 0 0 var(--trazo-contorno) var(--color-salida-borde)}"
    },
    {
      "name": "Ficha de token · razonamiento",
      "kind": "chip",
      "refersTo": "ficha-razonamiento",
