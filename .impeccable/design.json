      "html": "<span class=\"ds-coste\"><svg class=\"ds-ic\" width=\"36\" height=\"36\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"8\" cy=\"8\" r=\"6\"/><path d=\"M18.09 10.37A6 6 0 1 1 10.34 18\"/><path d=\"M7 6h1v4\"/><path d=\"m16.71 13.88.7.71-2.82 2.82\"/></svg>0,050 u.</span>",
      "css": ".ds-coste{display:inline-flex;align-items:center;gap:12px;height:64px;padding:0 26px;border-radius:var(--radio-pildora);background:var(--color-coste);color:var(--color-sobre-coste);font:var(--peso-enfasis) var(--tipo-mono)/1 var(--fuente-mono);font-variant-numeric:var(--cifras)}.ds-ic{fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex:none}"
    },
